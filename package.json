{
  "name": "organigramma-aziendale",
  "version": "1.0.0",
  "description": "Componenti e applicazione interattiva per la gestione, visualizzazione ed esportazione di organigrammi aziendali con supporto Mermaid",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./components/*": "./src/components/*",
    "./context/*": "./src/context/*",
    "./hooks/*": "./src/hooks/*",
    "./pages/*": "./src/pages/*",
    "./utils/*": "./src/utils/*",
    "./types": "./src/types/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.0.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
